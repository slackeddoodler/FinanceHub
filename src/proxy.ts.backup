  // This strict Regex ensures the proxy runs on your application pages
  // but explicitly IGNORES static files, images, and your /api/ routes.
  // Ignoring /api/ prevents network drops and fetch errors.
  matcher: ["/((?!api|_next/static|_next/image|favicon.ico).*)"],
};